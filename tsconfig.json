{
  // Type-checking untuk kode yang JALAN apa adanya di browser.
  //
  // Kenapa tidak .ts asli: file .ts tidak bisa dilayani browser tanpa build
  // step, dan project ini sengaja tidak punya build. Anotasi ditulis sebagai
  // JSDoc + `// @ts-check` di tiap modul, jadi editor tetap memberi
  // IntelliSense dan `tsc` tetap menangkap salah ketik — tanpa bundler,
  // tanpa node_modules, tanpa mengubah cara file disajikan ke browser.
  //
  // Jalankan: tsc -p .
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // Sengaja tidak strict. Kode yang diekstrak dari index.html belum punya
    // anotasi lengkap, dan `strict` akan menghasilkan ratusan error null/
    // implicit-any yang menutupi masalah yang sebenarnya penting. Goal-nya
    // menangkap salah ketik dan pemanggilan fungsi yang salah, bukan memaksa
    // anotasi penuh sekaligus.
    "strict": false,
    "noImplicitAny": false,

    "skipLibCheck": true,

    // Tidak ada @types di project ini (belum ada node_modules), dan kita juga
    // tidak mau TS mengarang global dari ambient yang tidak benar-benar ada.
    "types": []
  },

  // Hanya src dan api. Sengaja tidak termasuk test/ (butuh @types/node) dan
  // sw.js (butuh lib WebWorker yang bentrok dengan DOM). Keduanya sudah
  // dijaga test-nya masing-masing: test_pwa.mjs untuk sw.js, dan test/*.mjs
  // untuk modul src.
  "include": ["src/**/*.js", "src/**/*.d.ts", "api/**/*.ts"]
}
