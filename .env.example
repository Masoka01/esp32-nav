# Salin file ini jadi `.env.local`, lalu isi nilainya.
#
#   cp .env.example .env.local
#
# `.env.local` sudah masuk .gitignore, jadi nilai aslinya tidak ikut ter-push.
#
# Kenapa semua diawali NEXT_PUBLIC_: Firebase client SDK berjalan di browser,
# jadi kredensialnya memang harus sampai ke sana. `NEXT_PUBLIC_` adalah cara
# Next.js menyajikannya secara eksplisit, bukan kebocoran yang tidak sengaja.
# Kuncinya tetap perlu dibatasi di Google Cloud Console (API Key restrictions)
# supaya tidak bisa dipakai untuk project lain.

# Firebase — Analytics
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
